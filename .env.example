# Required to run the agent and LLM-backed DeepEval metrics.
OPENAI_API_KEY=

# MongoDB product source. No credentials are stored in source control.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=product_agent
MONGODB_COLLECTION=ProductUPC

# Optional model and evaluation configuration.
PRODUCT_AGENT_MODEL=gpt-4.1-mini
EVALUATION_MODEL=gpt-4.1-mini
PRODUCT_AGENT_SAMPLE_UPC=0001960004580
